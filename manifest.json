{
  "manifest_version": 2,
  "name": "Password Generator - سازنده رمز عبور",
  "version": "1.0.0",
  "description": "سازنده رمز عبور قوی و امن با قابلیت‌های مختلف | Strong Password Generator by AnishtayiN",
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "storage"
  ],
  "browser_action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "سازنده رمز عبور | Password Generator",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": "script-src 'self'; object-src 'self'"
}
